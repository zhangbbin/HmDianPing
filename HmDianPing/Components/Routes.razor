@using HmDianPing.Components.Layout
@using HmDianPing.Components.Pages
@* 👆 引入 Pages 命名空间，以便能识别 "Login" 类 *@

<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        @* 👇 【暴力解法】直接判断：如果你要访问的是 Login 页面 *@
        @if (routeData.PageType == typeof(Login))
        {
            @* 🚪 给他开个后门：使用普通的 RouteView，不进行任何身份检查 *@
            <RouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)" />
        }
        else
        {
            @* 🔒 其他所有页面：走正常的保安通道，检查身份 *@
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
                <NotAuthorized>
                    <div class="alert alert-warning m-4">
                        🛑 您没有权限访问此页面，请先 <a href="login">登录</a>。
                    </div>
                </NotAuthorized>
                <Authorizing>
                    <div class="m-4">身份校验中...</div>
                </Authorizing>
            </AuthorizeRouteView>
        }
    </Found>
    <NotFound>
        <PageTitle>Not found</PageTitle>
        <LayoutView Layout="typeof(MainLayout)">
            <p role="alert">Sorry, there's nothing at this address.</p>
        </LayoutView>
    </NotFound>
</Router>