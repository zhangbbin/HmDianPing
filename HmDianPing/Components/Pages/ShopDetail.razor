@page "/shop/{Id:long}"
@rendermode InteractiveServer
@using HmDianPing.Web.Models
@using HmDianPing.Web.Security
@using HmDianPing.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject ShopService ShopService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthProvider

<PageTitle>店铺详情 - @(shop?.Name ?? "加载中")</PageTitle>

<div class="container mt-4">
    @* 返回按钮 *@
    <button class="btn btn-outline-secondary mb-3" @onclick="GoBack">
        <i class="bi bi-arrow-left"></i> 返回列表
    </button>

    @if (isLoading)
    {
        <div class="d-flex justify-content-center">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (shop == null)
    {
        <div class="alert alert-danger">
            未找到 ID 为 @Id 的店铺信息。
        </div>
    }
    else
    {
        <div class="card shadow-lg">
            <div class="row g-0">
                <div class="col-md-5 p-3">
                    @{
                        var images = GetImageList(shop.Images);
                        var cover = images.FirstOrDefault() ?? "https://placehold.co/800x600/efefef/666?text=No+Image";
                    }

                    <img src="@cover" class="img-fluid rounded border w-100" style="object-fit: cover; min-height: 320px;" alt="@shop.Name">

                    @if (images.Count > 1)
                    {
                        <div class="row g-2 mt-2">
                            @foreach (var image in images.Take(4))
                            {
                                <div class="col-3">
                                    <img src="@image" class="img-fluid rounded border" style="height: 60px; width: 100%; object-fit: cover;" alt="@shop.Name 图片">
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="col-md-7">
                    <div class="card-body">
                        <h2 class="card-title fw-bold">@shop.Name</h2>
                        <div class="mb-2 d-flex align-items-center gap-2 flex-wrap">
                            <span class="badge bg-warning text-dark fs-6">⭐ @shop.Score 分</span>
                            <span class="text-muted">人均 ¥@shop.AvgPrice</span>
                            <span class="text-warning">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <span>@(i <= Math.Round((double)shop.Score) ? "★" : "☆")</span>
                                }
                            </span>
                        </div>

                        <ul class="list-group list-group-flush mb-3">
                            <li class="list-group-item">
                                <i class="bi bi-geo-alt text-primary"></i>
                                <strong>地址：</strong> @shop.Address (@shop.Area)
                            </li>
                            <li class="list-group-item">
                                <i class="bi bi-clock text-info"></i>
                                <strong>营业时间：</strong> @GetBusinessHours(shop)
                            </li>
                            <li class="list-group-item">
                                <i class="bi bi-telephone text-success"></i>
                                <strong>电话：</strong> @GetContactPhone(shop)
                            </li>
                            <li class="list-group-item">
                                <i class="bi bi-chat-dots text-success"></i>
                                <strong>评价数：</strong> @shop.Comments 条
                            </li>
                        </ul>

                        <div class="mb-3">
                            <h6 class="fw-bold mb-2">🍽️ 推荐菜</h6>
                            @foreach (var dish in GetRecommendedDishes(shop))
                            {
                                <span class="badge bg-light text-dark border me-2 mb-2">@dish</span>
                            }
                        </div>

                        <div class="alert alert-light border mb-3">
                            <h6 class="fw-bold mb-1">📝 评论摘要</h6>
                            <div class="text-muted small">@GetReviewSummary(shop)</div>
                        </div>

                        <div class="d-grid gap-2 d-md-block">
                            <button class="btn btn-primary" @onclick="AddHeat">
                                <i class="bi bi-hand-thumbs-up"></i> 觉得有用 (@shop.Comments)
                            </button>
                            @if (canEditShop)
                            {
                                <a href="/shop/edit/@shop.Id" class="btn btn-outline-secondary">
                                    <i class="bi bi-pencil-square"></i> 编辑
                                </a>
                            }
                            <button class="btn btn-outline-danger">收藏店铺</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public long Id { get; set; }  // 接收路由参数

    private Shop? shop;
    private bool isLoading = true;
    private bool canEditShop;

    protected override async Task OnInitializedAsync()
    {
        // 模拟加载延迟，体验更好
        await Task.Delay(300);
        shop = await ShopService.GetShopByIdAsync(Id);
        canEditShop = await CheckCanEditShopAsync();
        isLoading = false;
    }

    private async Task<bool> CheckCanEditShopAsync()
    {
        if (shop == null)
        {
            return false;
        }

        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated != true)
        {
            return false;
        }

        if (user.IsInRole(RoleConstants.Admin) || user.IsInRole(RoleConstants.SuperAdmin))
        {
            return true;
        }

        if (!user.IsInRole(RoleConstants.Merchant))
        {
            return false;
        }

        var userId = user.FindFirstValue(ClaimTypes.NameIdentifier);
        return long.TryParse(userId, out var currentUserId) && shop.OwnerUserId == currentUserId;
    }

    private void GoBack()
    {
        // 使用 NavigationManager 返回上一页
        Navigation.NavigateTo("/shops");
    }

    private async Task AddHeat()
    {
        if (shop == null) return;

        await ShopService.AddCommentCountAsync(shop.Id);
        shop.Comments += 1;
    }

    private static List<string> GetImageList(string? imageText)
    {
        if (string.IsNullOrWhiteSpace(imageText))
        {
            return new List<string>();
        }

        return imageText
            .Split([',', '，', ';', '|'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Distinct()
            .ToList();
    }

    private static string GetBusinessHours(Shop shop)
    {
        return string.IsNullOrWhiteSpace(shop.BusinessHours) ? "10:00 - 22:00" : shop.BusinessHours;
    }

    private static string GetContactPhone(Shop shop)
    {
        return string.IsNullOrWhiteSpace(shop.Phone) ? "400-800-1234" : shop.Phone;
    }

    private static List<string> GetRecommendedDishes(Shop shop)
    {
        if (shop.Dishes.Count > 0)
        {
            return shop.Dishes
                .OrderBy(x => x.SortOrder)
                .Select(x => x.Name)
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Distinct()
                .Take(6)
                .ToList();
        }

        if (!string.IsNullOrWhiteSpace(shop.RecommendedDishes))
        {
            return shop.RecommendedDishes
                .Split([',', '，', ';', '|'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Distinct()
                .Take(6)
                .ToList();
        }

        var dishes = new List<string>();

        if (shop.AvgPrice >= 120)
        {
            dishes.AddRange(["黑椒牛排", "海鲜拼盘", "提拉米苏"]);
        }
        else if (shop.AvgPrice >= 60)
        {
            dishes.AddRange(["招牌烤鱼", "蒜蓉生蚝", "手打柠檬茶"]);
        }
        else
        {
            dishes.AddRange(["经典汉堡", "薯条拼盘", "冰柠可乐"]);
        }

        if (!string.IsNullOrWhiteSpace(shop.Area))
        {
            dishes.Add($"{shop.Area}人气推荐");
        }

        return dishes.Take(4).ToList();
    }

    private static string GetReviewSummary(Shop shop)
    {
        if (!string.IsNullOrWhiteSpace(shop.ReviewSummary))
        {
            return shop.ReviewSummary;
        }

        var level = shop.Score switch
        {
            >= 4.8m => "口碑极佳，回头客很多",
            >= 4.5m => "整体体验优秀，值得专程打卡",
            >= 4.0m => "口味稳定，综合表现不错",
            >= 3.5m => "评价中规中矩，可按需尝试",
            _ => "近期评价一般，建议先看最新点评"
        };

        return $"基于 {shop.Comments} 条公开评价，当前综合评分 {shop.Score:F1} 分，{level}。";
    }

}
